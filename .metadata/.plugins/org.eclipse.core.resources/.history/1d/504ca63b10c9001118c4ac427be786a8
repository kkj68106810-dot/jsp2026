<!-- 구구단 2단부터 9단까지 -->

<% 
	String printStr = "";
	for(int i = 2; i <10; i++) {
		for(int j = 1; j<10; j++) {
			printStr += i + "X" + j + "=";
			printStr += i*j + " ";
			if(j == 9) {
				%>
				<%!
					<table>
				<thead>
				</thead>
				<tbody>
				</tbody>
				</table>
				
				%>
				
				<% 
				printStr += "<br>";
			}
			
		}		
	}
%>

<%= printStr %> 






</body>
